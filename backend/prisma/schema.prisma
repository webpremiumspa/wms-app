generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Espejo ligero del usuario WP. Las credenciales viven en WordPress;
// aquí guardamos solo lo necesario para mostrar el operario en la UI
// y resolver capabilities sin pegarle a WP en cada request.
model UserMeta {
  wpUserId      Int      @id @map("wp_user_id")
  username      String   @db.VarChar(120)
  displayName   String   @map("display_name") @db.VarChar(180)
  email         String?  @db.VarChar(180)
  capabilities  Json
  active        Boolean  @default(true)
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  processesCreated DeliveryProcess[] @relation("ProcessCreator")
  sequencesCreated Sequence[] @relation("SequenceCreator")
  packedOrders     Order[]    @relation("OrderPacker")
  pickedOrders     Order[]    @relation("OrderPicker")
  b2ClosedOrders   Order[]    @relation("OrderB2Closer")
  events           Event[]

  @@map("users_meta")
}

// Espejo del producto WC. Lo poblamos por sync (webhook product.updated
// o pull on-demand). Guarda la bodega para evitar consultar WC en cada picking.
model ProductMeta {
  wpProductId   Int      @id @map("wp_product_id")
  sku           String?  @db.VarChar(120)
  name          String   @db.VarChar(255)
  warehouse     Warehouse?
  thumbnailUrl  String?  @map("thumbnail_url") @db.VarChar(500)
  syncedAt      DateTime @default(now()) @map("synced_at")

  orderItems    OrderItem[]

  @@index([sku])
  @@index([warehouse])
  @@map("products_meta")
}

model Order {
  id              Int      @id @default(autoincrement())
  wpOrderId       Int      @unique @map("wp_order_id")
  number          String   @db.VarChar(64)
  status          OrderStatus @default(received)
  // Estado WC tal cual (slug). Independiente de `status` interno del WMS:
  // refleja lo que se ve en el admin de WC ("en-preparacion",
  // "en-ruta-pendiente", "en-ruta-express-y", "completed", "cancelled"...).
  // Se refresca por webhook order.updated. Útil como chip de contexto en la
  // UI: si un pedido cambió de estado en WC, el supervisor lo ve sin tener
  // que pegarle a sync manual.
  wcStatus        String?  @map("wc_status") @db.VarChar(60)
  wcStatusUpdatedAt DateTime? @map("wc_status_updated_at")
  route           String?  @db.VarChar(64)
  stopPosition    Int?     @map("stop_position")
  customerName     String?  @map("customer_name") @db.VarChar(200)
  customerAddress  String?  @map("customer_address") @db.VarChar(500)
  customerAddress2 String?  @map("customer_address2") @db.VarChar(255)
  customerCity     String?  @map("customer_city") @db.VarChar(120)
  customerPhone    String?  @map("customer_phone") @db.VarChar(40)
  customerNote     String?  @map("customer_note") @db.Text
  shippingMethod  String?  @map("shipping_method") @db.VarChar(200)
  driverId        Int?     @map("driver_id")
  driverName      String?  @map("driver_name") @db.VarChar(200)
  vehicle         String?  @db.VarChar(200)
  patente         String?  @db.VarChar(50)
  hasB2Pending    Boolean  @default(false) @map("has_b2_pending")
  bagsExpected    Int      @default(1) @map("bags_expected")
  // Entrega parcial aprobada: si el cliente acepta recibir el pedido aunque
  // falten items B2 (sin stock), un operador con cap pack_b1 puede autorizar.
  // Cuando es true, el chequeo de bloqueo en dispatch se omite y el albarán
  // muestra qué items NO van en esta entrega.
  allowPartialDelivery Boolean @default(false) @map("allow_partial_delivery")
  partialDeliveryNote  String? @map("partial_delivery_note") @db.VarChar(500)
  // Claim del picker: se setea al escanear el QR del albarán para empezar
  // a preparar el pedido. Bloquea a otros pickers de tomar el mismo pedido.
  pickedById      Int?     @map("picked_by_id")
  claimedAt       DateTime? @map("claimed_at")
  packedById      Int?     @map("packed_by_id")
  packedAt        DateTime? @map("packed_at")
  // Cierre B2 por pedido: el picker B2 escanea el QR del albarán, marca los
  // items B2 que pone en la sub-bolsa del pedido y cierra. Cuando todos los
  // pedidos con B2 de una secuencia tienen b2ClosedAt → la secuencia
  // auto-cierra su flujo B2.
  b2ClosedById    Int?     @map("b2_closed_by_id")
  b2ClosedAt      DateTime? @map("b2_closed_at")
  classifiedAt    DateTime? @map("classified_at")
  loadedAt        DateTime? @map("loaded_at")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  packedBy        UserMeta? @relation("OrderPacker", fields: [packedById], references: [wpUserId])
  pickedBy        UserMeta? @relation("OrderPicker", fields: [pickedById], references: [wpUserId])
  b2ClosedBy      UserMeta? @relation("OrderB2Closer", fields: [b2ClosedById], references: [wpUserId])
  items           OrderItem[]
  sequenceLinks   SequenceOrder[]
  events          Event[]

  @@index([status])
  @@index([route])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  productId     Int      @map("product_id")
  qty           Int
  warehouse     Warehouse
  // Nombre tal como vino del line_item de WC. Incluye la variante (ej.
  // "Heno Oxbow - 425Gr Banana"). Si difiere de productMeta.name, la UI
  // lo muestra para que el picker vea el sabor/color/tamaño exacto.
  lineName      String?   @map("line_name") @db.VarChar(255)
  pickedAt      DateTime? @map("picked_at")
  packedAt      DateTime? @map("packed_at")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       ProductMeta @relation(fields: [productId], references: [wpProductId])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Secuencia de picking: agrupa N pedidos. Es agnóstica de bodega — los items
// B1 los pickea el equipo de Bodega 1 (y se empacan en bolsa) y los items B2
// los pickea el equipo de Bodega 2 (a granel para el día). Cada flujo cierra
// por separado (b1ClosedAt / b2ClosedAt); status global pasa a 'closed' cuando
// ambos están cerrados.
//
// Modelo simplificado: solo existe el flujo "por pedido" (cada picker escanea
// el QR del albarán impreso y empaca un pedido completo). El modo "por SKU"
// fue eliminado del modelo (era poco usado y agregaba complejidad).
// Proceso de preparación y carga. Es el contenedor del trabajo de un turno
// (matutino o vespertino). Agrupa N secuencias y se cierra automáticamente
// cuando todos sus pedidos están cargados al vehículo. Restricción de negocio:
// solo puede haber 1 proceso abierto a la vez.
model DeliveryProcess {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(200)
  scheduledAt     DateTime? @map("scheduled_at")
  createdById     Int      @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")
  status          ProcessStatus @default(open)

  createdBy       UserMeta @relation("ProcessCreator", fields: [createdById], references: [wpUserId])
  sequences       Sequence[]

  @@index([status])
  @@map("delivery_processes")
}

model Sequence {
  id            Int      @id @default(autoincrement())
  processId     Int      @map("process_id")
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  closedAt      DateTime? @map("closed_at")
  b1ClosedAt    DateTime? @map("b1_closed_at")
  b2ClosedAt    DateTime? @map("b2_closed_at")
  expectedBags  Int      @default(0) @map("expected_bags")
  actualBags    Int      @default(0) @map("actual_bags")
  status        SequenceStatus @default(open)

  process       DeliveryProcess @relation(fields: [processId], references: [id])
  createdBy     UserMeta @relation("SequenceCreator", fields: [createdById], references: [wpUserId])
  orders        SequenceOrder[]

  @@index([processId])
  @@map("sequences")
}

model SequenceOrder {
  sequenceId    Int      @map("sequence_id")
  orderId       Int      @map("order_id")

  sequence      Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([sequenceId, orderId])
  @@map("sequence_orders")
}

// Log de eventos para trazabilidad (quién hizo qué sobre qué pedido).
model Event {
  id            Int      @id @default(autoincrement())
  type          String   @db.VarChar(60)
  actorId       Int?     @map("actor_id")
  orderId       Int?     @map("order_id")
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  actor         UserMeta? @relation(fields: [actorId], references: [wpUserId])
  order         Order?   @relation(fields: [orderId], references: [id])

  @@index([type])
  @@index([orderId])
  @@map("events")
}

enum Warehouse {
  B1
  B2
}

enum OrderStatus {
  received       // pedido sincronizado, aún no asignado a secuencia
  sequenced      // ya está en una secuencia abierta
  picked         // items recolectados
  packed         // bolsa armada
  classified     // QR escaneado en la mañana, ruta confirmada
  loaded         // subido a la camioneta
  delivered      // entregado (lo escribe el repartidor o el sistema externo)
  blocked        // sacado de secuencia por faltante (B1/B2) o cancelación
}

enum SequenceStatus {
  open
  closed
}

enum ProcessStatus {
  open
  closed
}
